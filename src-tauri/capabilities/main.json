{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "youtube-page",
  "description": "Las páginas de YouTube Music y Spotify solo pueden enviar el estado de reproducción.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://music.youtube.com/*",
      "https://open.spotify.com/*"
    ]
  },
  "permissions": [
    "allow-report-state"
  ]
}
